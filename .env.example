# 复制为 .env 后按需修改；未设置的项使用 config.py 中的默认值

# ===== Web 服务 =====
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
# 启动后是否自动打开浏览器
OPEN_BROWSER=1
# 是否允许弹出系统目录选择框（无桌面环境可关掉）
ENABLE_BROWSE_DIALOG=1

# ===== 下载 =====
# 相对路径以项目根目录为基准
DOWNLOAD_DIR=downloads
# 单个请求超时（秒）与分片下载超时（秒）
REQUEST_TIMEOUT=20
DOWNLOAD_TIMEOUT=60
# 下载失败重试次数
DOWNLOAD_RETRIES=2
# 文件名最大长度（Windows 路径长度限制）
FILENAME_MAX_LEN=80

# ===== B站 =====
BILI_COOKIE_FILE=bilibili_cookies.pkl
# 扫码登录等待上限（秒）
SELENIUM_LOGIN_TIMEOUT=300
# 登录状态检查结果的缓存时间（秒）
COOKIE_CHECK_TTL=60
# fnval=4048: DASH + 4K + HDR + 杜比 + 8K + AV1
BILI_FNVAL=4048
BILI_QN=127

# ===== 抖音 =====
# 0 表示自动分配调试端口，避免与已打开的浏览器冲突
DOUYIN_BROWSER_PORT=0
DOUYIN_API_TIMEOUT=30
DOUYIN_HEADLESS=0
# 自定义浏览器路径（一般留空，由 DrissionPage 自动查找 Chrome/Edge）
DOUYIN_BROWSER_PATH=
